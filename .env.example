# Copy to .env (never commit .env).

# Where TrueForge runs. Local `npx @truefoundry/trueforge@latest` serves http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only when your TrueForge server has OIDC login on (hosted setups). Local npx needs none.
TRUEFORGE_TOKEN=

# The model must exist in Settings → Models, written as provider/model. Overrides agent/agent.json.
TF_MODEL=
TF_AGENT_NAME=

# "skill_mode": "git" clones the warden skill from this PUBLIC repo, pinned to the commit that runs.
# That commit must already be pushed to GitHub before npm run run-evals.
SKILL_REPO_URL=https://github.com/Belukia/the-house-that-learns

# Model keys do NOT go here: add them in the TrueForge UI (Settings → Models). Agents never hold keys.

# Only for the game server's /api/learn (server.mjs): the immutable commit of the skill it should load.
SKILL_GIT_REF=
