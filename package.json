{
  "name": "the-house-that-learns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval": "node scripts/evaluate.mjs",
    "eval:trueforge": "node --env-file=.env scripts/run-trueforge-evals.mjs",
    "learn": "node scripts/learn.mjs",
    "setup": "tsx scripts/setup.ts",
    "run-evals": "tsx scripts/run-evals.ts",
    "improve": "tsx scripts/improve.ts",
    "export-session": "tsx scripts/export-session.ts",
    "score": "tsx evals/score.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.182.0"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "^0.182.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.14"
  }
}
